# dependencies
/node_modules
/.pnp
.pnp.*

# 构建产物
/.next/
/out/
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files
.env
.env.local
.env*.local
# backend/.env 由 .env.example 复制，永不进仓库
backend/.env

# python backend
__pycache__/
*.py[cod]
.venv/
venv/
*.db
.pytest_cache/
# backend/static/ 由 scripts/build-backend-static.js 生成（同源托管产物），永不进仓库
backend/static/

# 类型层（jsconfig + JSDoc，无编译步骤；仅防编辑器残留）
*.tsbuildinfo
next-env.d.ts

# test
/coverage

# 本地临时备份
.v*-backup.html
*.tmp

# 在线演示镜像的发布目录（由 scripts/stage-mirror.js 生成的纯产物）
/.mirror-site/

# 端侧模型权重（约 23MB，由 scripts/fetch-model.js 下载，进发布产物但不进主仓库历史）
/public/models/

# 交付辅助材料（讲解脚本 / 自查表 / 核对表）只存本地工作区，永不入库
/deliverables/
*-讲解脚本.md
*-交付核对表.md
*-自查.md
*-审核表.md

# Vue 展示层（评分方法页）：依赖与中间产物不入库，docs/scoring-method.html 是提交的交付物
/vue-scoring-method/node_modules/
/vue-scoring-method/dist/

# 演示视频源文件（64.7MB，由 build-backend-static 复制进静态目录，不入库）
/media/

# 打印版技术文档（9.8MB，超过 GitHub 单次上传上限，只作 Release 附件）
/docs/*.pdf
