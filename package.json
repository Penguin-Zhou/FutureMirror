{
  "name": "futuremirror",
  "version": "1.1.0",
  "private": true,
  "description": "面镜 FutureMirror：多 Agent 驱动的 AI 模拟面试与能力成长平台",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:jsdom": "node scripts/run-tests.js",
    "test:demo": "node scripts/run-tests.js test-demo-logic",
    "test:all": "node scripts/run-tests.js && vitest run && tsc --noEmit -p .",
    "validate:demo": "node scripts/validate-demo.js",
    "build:demo": "node scripts/build-demo.js",
    "build:changelog": "node scripts/build-changelog.js",
    "build:doc": "node scripts/build-print-doc.js",
    "deploy:pages": "node scripts/deploy-pages.js --build",
    "mirror:stage": "node scripts/stage-mirror.js",
    "model:fetch": "node scripts/fetch-model.js"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.400.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
