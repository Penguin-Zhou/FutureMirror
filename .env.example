# ============================================================
# 面镜 FutureMirror 环境变量模板
# 使用方式：cp .env.example .env.local，然后填入你的 Key
# 注意：所有 Key 留空也能运行——系统自动进入 Mock 演示模式
# ============================================================

# ---- 大模型 API（免费额度优先，按顺序自动选择第一个可用的）----

# 1) Gemini 免费额度（推荐，多模态能力强）
#    获取地址：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2) OpenRouter 免费模型（每日有免费额度）
#    获取地址：https://openrouter.ai/keys
OPENROUTER_API_KEY=

# 3) 智谱 GLM（提供免费 Flash 模型，国内访问稳定）
#    获取地址：https://open.bigmodel.cn/usercenter/apikeys
ZHIPU_API_KEY=

# 4) DeepSeek（低价，非免费）
#    获取地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# 5) 任意 OpenAI 兼容服务（硅基流动 / 火山方舟 / OneAPI 等）
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# ---- 运行模式 ----
# AI_MOCK=1 时强制进入本地 Mock 模式（无网络演示环境兜底，忽略上面所有 Key）
AI_MOCK=0

# ---- Week 2 预留：Supabase（Postgres + pgvector）----
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
