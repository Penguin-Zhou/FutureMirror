# ============================================================
# 面镜 FutureMirror 环境变量模板
#
# 仓库里有两套运行环境，变量互不通用，请按需取用：
#
#   ① FastAPI 后端（backend/）——线上演示 / 自建部署走这一套
#      实际生效：cp backend/.env.example backend/.env
#      （本文件第二段完整抄录了其内容，便于在仓库根目录查阅）
#
#   ② 早期 Next.js 原型（app/ + lib/ai/providers.ts）
#      仅在 `npm run dev` 跑该原型时需要，后端不读取
#
# 所有 Key 留空也能运行：系统自动进入 Mock 演示模式，功能不缺失。
# 任何 Key 都只存在于服务端环境变量，前端零接触。
# ============================================================


# ============================================================
# 构建期变量（只在本地打包产物时使用，不进仓库）
# ============================================================

# 演示页打包时注入的后端地址，决定单文件演示版连哪个后端：
#   留空          → 纯前端 Mock 版（public/futuremirror-demo.html 的仓库态）
#   same-origin   → 与页面同源（国内镜像：后端同源托管，免 CORS）
#   https://xxx   → 跨域地址（GitHub Pages 固定指向国内镜像）
# 发布 Pages 时必须显式带上，否则会把纯 Mock 版推上去：
#   FM_API_BASE=https://futuremirror-demo.app.workbuddy.host node scripts/deploy-pages.js --build
FM_API_BASE=


# ============================================================
# ① FastAPI 后端变量（与 backend/.env.example 一致）
# ============================================================

# ---- 大模型 API（OpenAI 兼容协议；Key 只存在于服务端环境变量）----
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash
LLM_API_KEY=

# ---- 安全 ----
# JWT 签名密钥。留空时进程启动会随机生成（重启后旧令牌失效）；
# 生产环境建议显式设置为足够长的随机串，保证重启后令牌仍有效。
SECRET_KEY=

# ---- 数据库 ----
DATABASE_URL=sqlite:///./futuremirror.db

# ---- CORS（允许跨域访问的演示页来源，逗号分隔）----
# 默认值已包含本地开发端口与两个在线演示域名；部署到其他域名时在此追加
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://penguin-zhou.github.io,https://futuremirror-demo.app.workbuddy.host

# ---- 演示账号（启动时自动种子；改密码需同步 frontend/js/data/config.js 的 testAccount）----
DEMO_EMAIL=demo@futuremirror.app
DEMO_PASSWORD=Demo123456


# ============================================================
# ② 早期 Next.js 原型变量（后端不读取）
# ============================================================
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ZHIPU_API_KEY=
DEEPSEEK_API_KEY=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# AI_MOCK=1 时强制进入本地 Mock 模式（无网络演示环境兜底，忽略上面所有 Key）
AI_MOCK=0
